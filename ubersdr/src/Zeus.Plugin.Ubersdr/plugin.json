{
  "schemaVersion": 1,
  "id": "be.on8st.zeus.plugins.ubersdr",
  "name": "UberSDR Monitor",
  "version": "0.1.0",
  "author": "on8st",
  "description": "Remote UberSDR receivers, two ways. QSO Assist puts your own radio in the left ear and whichever remote station copies the frequency best in the right, choosing and re-choosing on its own. The map shows where you are being heard while you transmit, with a recording from each receiver. Audio never enters the Zeus DSP chain.",
  "homepage": "https://github.com/on8st/zeus-plugins",
  "license": "GPL-2.0-or-later",
  "sdk": {
    "abi": 1,
    "minVersion": "1.4.0"
  },
  "entrypoint": {
    "assembly": "Zeus.Plugin.Ubersdr.dll",
    "type": "Zeus.Plugin.Ubersdr.UbersdrPlugin"
  },
  "capabilities": [
    "NetworkAccess"
  ],
  "permissions": {
    "network": true
  },
  "ui": {
    "modules": [
      "ui/ubersdr.es.js",
      "ui/qso-assist.js"
    ],
    "panels": [
      {
        "id": "ubersdr.qso",
        "title": "QSO Assist",
        "icon": "Headphones",
        "slot": "workspace.tools",
        "category": "tools"
      },
      {
        "id": "ubersdr.monitor",
        "title": "UberSDR Map",
        "icon": "Radio",
        "slot": "workspace.tools",
        "category": "tools"
      }
    ]
  }
}
