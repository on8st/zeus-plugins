{
  "schemaVersion": 1,
  "id": "be.on8st.zeus.plugins.ubersdr",
  "name": "UberSDR Monitor",
  "version": "0.1.0",
  "author": "on8st",
  "description": "A wall of public UberSDR receivers listening to your transmission. Shows a live signal-to-noise figure from each while you are keyed. It is not a receiver: audio never enters the Zeus DSP chain, and nothing is played while you transmit.",
  "homepage": "https://github.com/on8st/zeus-plugins",
  "license": "GPL-2.0-or-later",
  "sdk": {
    "abi": 1,
    "minVersion": "1.4.0"
  },
  "entrypoint": {
    "assembly": "Zeus.Plugin.Ubersdr.dll",
    "type": "Zeus.Plugin.Ubersdr.UbersdrPlugin"
  },
  "capabilities": [
    "NetworkAccess"
  ],
  "permissions": {
    "network": true
  },
  "ui": {
    "modules": [
      "ui/ubersdr.es.js"
    ],
    "panels": [
      {
        "id": "ubersdr.monitor",
        "title": "UberSDR Monitor",
        "icon": "Radio",
        "slot": "workspace.tools",
        "category": "tools"
      }
    ]
  }
}
