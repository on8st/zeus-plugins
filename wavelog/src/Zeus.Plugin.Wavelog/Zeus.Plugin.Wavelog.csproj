<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <!-- A plugin is loaded through AssemblyDependencyResolver, which reads the
         .deps.json and looks for the assemblies beside it. A class library does
         not copy its NuGet dependencies to the output by default, so without
         this LiteDB.dll is simply absent at load time. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!-- The host resolves the contracts from the default load context, so the
         plugin must NOT ship its own copy: Private=false. See
         docs/plugin-framework-how-to.md §10. -->
    <ProjectReference Include="$(ZeusContractsProject)" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="LiteDB" Version="5.0.21" />
  </ItemGroup>
  <ItemGroup>
    <!-- The manifest is plugin.json, not manifest.json: verified against the
         GPL sample plugins the registry distributes. -->
    <None Include="plugin.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="ui/**/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests pin behaviour that is internal on purpose: ReadInt exists to
         absorb Wavelog's inconsistent JSON typing and has no business on the
         public surface. -->
    <InternalsVisibleTo Include="Zeus.Plugin.Wavelog.Tests" />
  </ItemGroup>

</Project>
